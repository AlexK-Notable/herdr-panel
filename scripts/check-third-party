#!/usr/bin/env python3
"""Fails unless the README's third-party table lists exactly the modules the
library and its tests compile against.

A row is `| `module/path` | licence | where |`. Rows whose "where" names tools,
integration or the spike are other modules' business and are not compared.
"""
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OTHER = ("tools", "integration", "spike", "not included")


def compiled_modules():
    out = subprocess.run(
        ["go", "list", "-deps", "-test", "-json=Module", "./..."],
        cwd=ROOT, capture_output=True, text=True, check=True).stdout
    mods, dec, i = set(), json.JSONDecoder(), 0
    while i < len(out):
        if out[i].isspace():
            i += 1
            continue
        doc, i = dec.raw_decode(out, i)
        mod = doc.get("Module")
        if mod and not mod.get("Main"):
            mods.add(mod["Path"])
    return mods


def table_modules():
    text = (ROOT / "README.md").read_text()
    section = text.split("### Third-party software", 1)
    if len(section) != 2:
        sys.exit("check-third-party: README has no '### Third-party software' section")
    rows = {}
    for line in section[1].splitlines():
        m = re.match(r"\|\s*`([^`]+)`\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|", line)
        if m:
            rows[m.group(1)] = (m.group(2), m.group(3))
    return {p for p, (_, where) in rows.items() if not any(o in where.lower() for o in OTHER)}, rows


def main():
    compiled = compiled_modules()
    listed, rows = table_modules()
    missing = sorted(compiled - listed)
    stale = sorted(listed - compiled)
    for path in missing:
        print(f"missing from README third-party table: {path}")
    for path in stale:
        print(f"listed in README but not compiled: {path}")
    if missing or stale:
        sys.exit(1)
    print(f"third-party table matches {len(compiled)} compiled modules")


if __name__ == "__main__":
    main()
